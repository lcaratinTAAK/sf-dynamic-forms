# =============================================================================
# Copie para `.env` e preencha. O `.env` é ignorado pelo git.
#
#   cp .env.example .env
#
# Existem DOIS modos de autenticação. Escolha um — não precisa preencher os dois.
# =============================================================================


# -----------------------------------------------------------------------------
# MODO 1 — Client Credentials
#
# É o modo representativo: o BFF autentica como aplicação, sem usuário no meio.
# Requer um External Client App na org com:
#
#   - OAuth habilitado, escopo `api`
#   - "Enable Client Credentials Flow" marcado
#   - um "Run As" user definido
#
# O "Run As" importa mais do que parece: é o profile DELE que decide qual Page
# Layout a UI API devolve. Se ele enxergar um layout diferente do que o cliente
# deveria ver, o formulário sai errado sem ninguém perceber.
# -----------------------------------------------------------------------------

SF_LOGIN_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# MODO 2 — Token direto
#
# Atalho para rodar antes de existir o External Client App. Pegue com:
#
#   sf org display --verbose --json -o <alias-da-org>
#
# Se SF_ACCESS_TOKEN estiver preenchido ele VENCE o modo 1. O token expira em
# algumas horas — serve para desenvolvimento, e só.
# -----------------------------------------------------------------------------

SF_ACCESS_TOKEN=
SF_INSTANCE_URL=


# -----------------------------------------------------------------------------
# Objeto de destino
# -----------------------------------------------------------------------------

SF_API_VERSION=66.0

# Objeto que o formulário cria.
SF_OBJECT=Case


# -----------------------------------------------------------------------------
# Objetos que guardam a definição
#
# Cada fonte usa um conjunto. Pode deixar todos preenchidos — o que não for
# usado simplesmente não é consultado.
# -----------------------------------------------------------------------------

# Catálogo: quais formulários existem e para qual Record Type cada um aponta.
SF_FORMS_OBJECT=FormDefinition__c

# Regras de visibilidade, obrigatoriedade e validação (fonte UI API).
SF_RULES_OBJECT=FormFieldRule__c

# Documentos exigidos (fonte UI API).
SF_DOCS_OBJECT=FormRequiredDocument__c

# OBSOLETO. Campo picklist que marcava os documentos exigidos antes de existir
# o objeto acima. Fica aqui só para o adaptador saber ignorá-lo caso ainda
# apareça num Page Layout antigo.
SF_DOCS_FIELD=FormRequiredDocuments__c


# -----------------------------------------------------------------------------
# Campos que o Salesforce obriga a manter no Page Layout mas que não pertencem
# ao formulário do cliente. A UI API não permite removê-los, então a exclusão
# é feita aqui — o mesmo contorno que o Magic Link usa hoje em produção.
# -----------------------------------------------------------------------------

SF_EXCLUDED_FIELDS=Status,Origin,Subject,Priority,ContactId,Description,SuppliedEmail,SuppliedName,SuppliedPhone,SuppliedCompany,OwnerId,CaseNumber,AccountId


# -----------------------------------------------------------------------------
PORT=3000
