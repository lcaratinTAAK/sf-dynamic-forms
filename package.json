{
  "name": "labs-sf-dynamic-forms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Formulários dinâmicos renderizados a partir da definição que vive no Salesforce.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file=.env --watch server/index.js",
    "dev:web": "vite",
    "check": "node scripts/offline-check.js",
    "build": "vite build",
    "start": "node --env-file=.env server/index.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.14"
  }
}
